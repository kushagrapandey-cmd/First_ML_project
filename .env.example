# Server-only settings. Copy to an ignored .env for an isolated environment.
# Never commit real credentials or reuse production credentials in tests.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Optional: a NEW restricted YouTube Data API v3 key for live retrieval.
YOUTUBE_API_KEY=
# Optional: set 0 to disable neural inference and use labelled keyword fallback.
YTGUIDE_SEMANTIC_ENABLED=1
